<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Workspace/build/GameLibs.props" Condition="Exists('../Workspace/build/GameLibs.props') and '$(SmtStandaloneBuild)' != 'true'" />
  <Import Project="build/GameLibs.props" Condition="!Exists('../Workspace/build/GameLibs.props') or '$(SmtStandaloneBuild)' == 'true'" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>HighlightBoxPlaces</AssemblyName>
    <Product>Highlightes all places where the product currently will be stored</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HighlightBoxPlaces</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2"
      PrivateAssets="all" />
  </ItemGroup>
</Project>
